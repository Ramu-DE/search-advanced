# ═══════════════════════════════════════════════════════════════════════
#  search-advanced — environment template
#  Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
#    cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── AWS Credentials ──────────────────────────────────────────────────────
# Needed by BOTH the rag-ui backend (Node AWS SDK) and the RAG notebooks (boto3).
# On your own machine you can instead run `aws configure` and skip the keys here.
AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
# Only needed when using temporary STS credentials (e.g. workshop / SSO).
# Leave blank or remove if you use long-lived IAM user keys.
AWS_SESSION_TOKEN=""

# ── Amazon Bedrock ───────────────────────────────────────────────────────
# These model IDs must be ENABLED in the Bedrock console for your region.
BEDROCK_REGION="us-east-1"
BEDROCK_EMBEDDING_MODEL="amazon.titan-embed-text-v2:0"
# rag-ui backend uses Claude Haiku; notebooks default to Claude Sonnet.
BEDROCK_LLM_MODEL="us.anthropic.claude-sonnet-4-6"

# ── Qdrant Cloud (used by the RAG notebooks) ─────────────────────────────
# Create a free cluster at https://cloud.qdrant.io and copy its URL + API key.
QDRANT_URL="https://YOUR_CLUSTER_ID.YOUR_REGION.aws.cloud.qdrant.io"
QDRANT_API_KEY="YOUR_QDRANT_API_KEY"
